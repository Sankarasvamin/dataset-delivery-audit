{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-v1.schema.json",
  "title": "IssueV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_id", "issue_category", "code", "severity", "delivery_id", "dataset_id", "path", "line", "member", "field", "expected", "observed", "evidence_fingerprint", "remediation_hint", "algorithm_version", "schema_version"],
  "properties": {
    "issue_id": {"type": "string", "pattern": "^issue:[0-9a-f]{64}$"},
    "issue_category": {"enum": ["ISS-01", "ISS-02", "ISS-03", "ISS-04"]},
    "code": {"type": "string", "minLength": 1},
    "severity": {"enum": ["BLOCKER", "ERROR", "WARNING", "INFO"]},
    "delivery_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "line": {"type": ["integer", "null"], "minimum": 1},
    "member": {"type": ["string", "null"]},
    "field": {"type": ["string", "null"]},
    "expected": {"type": ["object", "null"]},
    "observed": {"type": ["object", "null"]},
    "evidence_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "remediation_hint": {"type": "string", "minLength": 1},
    "algorithm_version": {"const": "delivery-audit-v1"},
    "schema_version": {"const": "issue-v1"}
  }
}

